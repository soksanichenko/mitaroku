msgid "Sign in"
msgstr "Войти"

msgid "Local account. Use this when the portal sign-in is not available."
msgstr "Локальная учётная запись. Используйте её, когда вход через портал недоступен."

msgid "The username or password is wrong. Try again."
msgstr "Неверное имя пользователя или пароль. Попробуйте ещё раз."

msgid "Username"
msgstr "Имя пользователя"

msgid "Password"
msgstr "Пароль"

msgid "Forgot your password? Ask the administrator of this server to reset it."
msgstr "Забыли пароль? Попросите администратора сервера сбросить его."

msgid "Adding…"
msgstr "Добавляем…"

msgid "Added"
msgstr "Добавлено"

msgid "Open"
msgstr "Открыть"

msgid "Couldn't add this title"
msgstr "Не удалось добавить"

msgid "Try again"
msgstr "Повторить"

msgid "Main"
msgstr "Главное меню"

msgid "Library"
msgstr "Библиотека"

msgid "Upcoming"
msgstr "Скоро"

msgid "Search"
msgstr "Поиск"

msgid "mitaroku, go to library"
msgstr "mitaroku, перейти в библиотеку"

msgid "Search shows, anime and movies"
msgstr "Поиск сериалов, аниме и фильмов"

msgid "Search shows, anime, movies"
msgstr "Сериалы, аниме, фильмы"

msgid "Account"
msgstr "Аккаунт"

msgid "Language"
msgstr "Язык"

msgid "Log out"
msgstr "Выйти"

msgid "Type a title above to search shows, anime and movies."
msgstr "Введите название выше, чтобы искать сериалы, аниме и фильмы."

msgid "Type at least 2 characters"
msgstr "Введите не менее 2 символов"

msgid "Search is unavailable"
msgstr "Поиск недоступен"

msgid "TMDB and AniList didn't respond, so we can't search. Titles already in your library still work."
msgstr "TMDB и AniList не ответили, поэтому поиск не работает. Тайтлы из вашей библиотеки по-прежнему доступны."

#, python-format
msgid "Results may be incomplete: %(failed_names)s did not respond."
msgstr "Результаты могут быть неполными: %(failed_names)s не ответил."

#, python-format
msgid "No results for “%(q)s”"
msgstr "Ничего не найдено по запросу «%(q)s»"

msgid "Check the spelling, or try the original title."
msgstr "Проверьте написание или попробуйте оригинальное название."

#, python-format
msgid "%(count)s result for “%(q)s”"
msgid_plural "%(count)s results for “%(q)s”"
msgstr[0] "%(count)s результат по запросу «%(q)s»"
msgstr[1] "%(count)s результата по запросу «%(q)s»"
msgstr[2] "%(count)s результатов по запросу «%(q)s»"

#, python-format
msgid "In your library: %(label)s"
msgstr "В вашей библиотеке: %(label)s"

#, python-format
msgid "Show all %(count)s"
msgstr "Показать все (%(count)s)"

msgid "Switch to dark theme"
msgstr "Включить тёмную тему"

msgid "Switch to light theme"
msgstr "Включить светлую тему"

msgid "Skip to content"
msgstr "Перейти к содержимому"

msgid "Episodes watched"
msgstr "Просмотрено серий"

#, python-format
msgid "%(source)s rating %(value)s out of 10"
msgstr "Рейтинг %(source)s: %(value)s из 10"

#, python-format
msgid "%(source)s rating, out of 10"
msgstr "Рейтинг %(source)s, из 10"

msgid "Nothing here yet"
msgstr "Здесь пока ничего нет"

msgid "Couldn't load this"
msgstr "Не удалось загрузить"

msgid "The server didn't respond. Nothing was lost. Try again in a moment."
msgstr "Сервер не ответил. Ничего не потеряно. Попробуйте ещё раз чуть позже."

msgid "Loading…"
msgstr "Загрузка…"

msgid "Untitled"
msgstr "Без названия"

#, python-format
msgid "Status of %(name)s: %(label)s. Change status"
msgstr "Статус «%(name)s»: %(label)s. Изменить статус"

msgid "Change status"
msgstr "Изменить статус"

#, python-format
msgid "Add %(name)s to library"
msgstr "Добавить «%(name)s» в библиотеку"

msgid "Add to library"
msgstr "Добавить в библиотеку"

msgid "Add"
msgstr "Добавить"

msgid "Add with status"
msgstr "Добавить со статусом"

msgid "Remove from library"
msgstr "Удалить из библиотеки"

msgid "Your titles will appear here."
msgstr "Здесь появятся ваши тайтлы."

msgid "Search and add"
msgstr "Поиск и добавление"

msgid "Title or original title"
msgstr "Название или оригинальное название"

msgid "Results from TMDB (shows and movies) and AniList (anime)."
msgstr "Результаты из TMDB (сериалы и фильмы) и AniList (аниме)."

msgid "Searching…"
msgstr "Ищем…"

msgid "Upcoming episodes and premieres will appear here."
msgstr "Здесь появятся ближайшие серии и премьеры."

msgid "Watching"
msgstr "Смотрю"

msgid "Plan to watch"
msgstr "Буду смотреть"

msgid "Completed"
msgstr "Просмотрено"

msgid "Dropped"
msgstr "Брошено"

msgid "Shows"
msgstr "Сериалы"

msgid "Anime"
msgstr "Аниме"

msgid "Movies"
msgstr "Фильмы"

msgid "Show"
msgstr "Сериал"

msgid "Movie"
msgstr "Фильм"

msgid "This took too long. Try again."
msgstr "Это заняло слишком много времени. Попробуйте ещё раз."

msgid "The metadata provider didn't respond. Try again."
msgstr "Источник данных не ответил. Попробуйте ещё раз."

msgid "Something went wrong. Try again."
msgstr "Что-то пошло не так. Попробуйте ещё раз."

#, python-format
msgid "%(count)s titles are already being added. Try again soon."
msgstr "Уже добавляется тайтлов: %(count)s. Попробуйте чуть позже."
